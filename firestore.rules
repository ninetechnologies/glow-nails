rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /listes/{listeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /clients/{clientId} {
      allow read, write: if request.auth != null
        && request.auth.uid == clientId;
    }

    match /appointments/{apptId} {
      allow read, write: if request.auth != null;
    }

    match /agenda/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /slots/{slotId} {
      allow read, write: if request.auth != null;
    }

    match /rdvs/{rdvId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }

    // Jours bloqués par Marion : les clientes doivent pouvoir les LIRE
    // pour griser le calendrier. Écriture réservée à l'admin (match global).
    // Règle ajoutée le 26/07/2026 — son absence rendait les jours bloqués
    // invisibles côté cliente (permission-denied silencieux).
    match /blocked/{dayId} {
      allow read: if request.auth != null;
    }

    match /disponibilites/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    match /notes_clientes/{noteId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
      allow update: if request.auth != null;
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
      }
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /galerie/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "glownails.contact31@gmail.com";
    }

    match /photos_clientes/{clientId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == clientId
        || request.auth.token.email == "glownails.contact31@gmail.com");
    }
  }
}
